# AlleDrops Symptom Quiz — local development environment
#
# Copy to `.env` and fill in. `.env` is gitignored (.gitignore:22) and must stay that way — it
# carries live credentials to a database holding PHI.
#
# NEVER commit real values here. This file is tracked.

# ─── Shopify app ──────────────────────────────────────────────────────────────
# Pull with `shopify app env pull`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SCOPES=read_customers,write_customers

# `npm run dev` does NOT work — it is `shopify app dev` and blocks on an interactive store prompt.
# Use: SHOPIFY_APP_URL=http://localhost:3000 npx react-router dev
# Pass it on the command line, with NO path component. A path breaks the Shopify admin client
# ("Received invalid shop argument").

# ─── Cloud SQL (PHI) ──────────────────────────────────────────────────────────
# Requires the Cloud SQL Auth Proxy running on 5436:
#   cloud-sql-proxy --port 5436 alledrops-quiz:us-east1:alledrops-quiz-data
#
# This is the kept 21 ads dev project: test data only, no PHI. Production runs on Cloud Run in
# AOD's own project with its own roles. NEVER point local dev at aod-production-510006
# (Playbook Part E.5: standing PHI access for 21 ads ends).
#
# Use the local-only `alledrops_dev` role, never `alledrops_app` — that is the credential the
# deployed app used. Port 5436, NOT 5433: another project's Docker container owns 5433 and
# connecting there produces a misleading `28P01 password authentication failed`.
#
# `sslmode=disable` is correct through the proxy, which terminates TLS itself.
#
# Full setup and rationale: docs/local-dev-database.md
DATABASE_URL="postgresql://alledrops_dev:<password>@127.0.0.1:5436/alledrops_quiz_dev?sslmode=disable"

# ─── Shopify sessions (Prisma) ────────────────────────────────────────────────
# Sessions live in Postgres, separate from the PHI database. Locally, use a throwaway container:
#   docker run -d --name aod-sessions -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=sessions -p 5437:5432 postgres:18-alpine
# then create the session table once:
#   npx prisma migrate deploy
SESSION_DATABASE_URL="postgresql://postgres:dev@127.0.0.1:5437/sessions"

# ─── Google Cloud Storage (uploaded test results — PHI files) ─────────────────
# Local auth is Application Default Credentials with impersonation, so no key lands on disk:
#   gcloud auth application-default login \
#     --impersonate-service-account=alledrops-quiz-app@alledrops-quiz.iam.gserviceaccount.com
#
# Impersonation is required, not optional: v4 signed URLs need a service-account private key to
# sign with, and plain user credentials have none. Without it, uploads work and every download
# fails with "Cannot sign data without `client_email`".
#
# Do not put a service-account key on disk; impersonation above is the supported local setup.
# See docs/gcs-credentials.md.
GCS_BUCKET_NAME=alledrops-quiz-uploads-dev
GCS_PROJECT_ID=alledrops-quiz

# ─── Deprecated ───────────────────────────────────────────────────────────────
# GOOGLE_SHEETS_WEB_APP_URL — do not set. app/lib/google-sheets.ts throws on call and has zero
# imports; it is a tripwire. Google Workspace is banned from the PHI path (CLAUDE.md rule 3).
