{
  "name": "alle-drops-quiz-app",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "build:theme": "vite build --config vite.theme.config.ts",
    "dev": "shopify app dev",
    "dev:theme": "vite build --config vite.theme.config.ts --watch",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@prisma/client": "^6.19.3",
    "@react-router/dev": "^7.18.4",
    "@react-router/fs-routes": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@remix-run/form-data-parser": "^0.17.7",
    "@shopify/app-bridge-react": "^4.2.14",
    "@shopify/shopify-app-react-router": "^1.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "heic-convert": "^2.1.0",
    "isbot": "^5.1.31",
    "jose": "^6.2.13",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "lodash": "^4.18.1",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  },
  "author": "andrewskinner"
}
